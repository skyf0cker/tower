{
  "name": "tower",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloud control plane for Surge & Stash subscriptions, node integration, and routing rules on Cloudflare Workers + D1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply tower-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tower-db --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@reclaimprotocol/tls": "^0.1.5",
    "hono": "^4.7.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.69.1",
    "@cloudflare/workers-types": "^5.20261113.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.2.1",
    "wrangler": "4.162.0"
  }
}
