{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tower",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // Bind your own custom domain after deploying:
  // "routes": [
  //   {
  //     "pattern": "tower.example.com",
  //     "custom_domain": true
  //   }
  // ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/sub/*", "/r/*", "/mcp"]
  },
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tower-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
  // Production Cloudflare Access JWT Verification:
  //   npx wrangler secret put CF_ACCESS_TEAM_DOMAIN
  //   npx wrangler secret put CF_ACCESS_AUD
  // Optional Remote MCP Bearer Token (/mcp):
  //   npx wrangler secret put MCP_API_TOKEN
}
